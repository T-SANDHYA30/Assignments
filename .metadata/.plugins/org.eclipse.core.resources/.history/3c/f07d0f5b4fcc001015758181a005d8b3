package com.threadss.multithreading;

public class Chef  extends Thread{
	
	private final String[] orders;
	public Chef(String... orders) {
		this.orders=orders;
		
	}

	public static void main(String[] args) throws InterruptedException {
		// TODO Auto-generated method stub
		Chef c1=new Chef("biryani","dosa","water");
		Chef c2=new Chef("idli","rasam","sugar");
		Chef c3=new Chef("upma","curd","pickle");
		Chef c4=new Chef("pulav","kushka","fish");
		
		c1.setName("chef-1");
		c2.setName("chef-1");
		c3.setName("chef-1");
		c4.setName("chef-1");
		
		c1.start();
		c2.start();
		c3.start();
		c4.start();
		
		c1.join();
		c2.join();
		c3.join();
		c4.join();
		
		

	}

}
