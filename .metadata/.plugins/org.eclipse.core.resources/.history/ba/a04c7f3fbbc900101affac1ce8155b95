package com.genrics;

public class Pair {
	
	private K key;
	private V value;
	public Pair(K key, V value) {
		super();
		this.key = key;
		this.value = value;   //here we took constructors or we can take getters & setters
	}
	public K getKey() {
		return key;
	}
	public V getValue() {
		return value;
	}
	
	
	@Override
	public String toString() {
		return "Pair []";
	}

}
