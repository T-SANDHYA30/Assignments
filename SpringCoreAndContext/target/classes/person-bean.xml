<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context" xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd"> <!-- bean definitions here -->
        
        <context:property-placeholder location="classpath:data.properties"/>

	<bean name="p" class="com.project.SpringCoreAndContext.beans.Person">

		<!--  <constructor-arg name="id" value="123"></constructor-arg>
		<constructor-arg name="name" value="madhu"></constructor-arg>
		<constructor-arg name="age" value="12"></constructor-arg>
		<constructor-arg name="langs">
		<list>
		<value>English</value>
		<value>Telugu</value>
		<value>Urdu</value>
		</list>-->
		
		
		<constructor-arg name="id" value="${Person.id}"></constructor-arg>
		<constructor-arg name="name" value="${Person.name}"></constructor-arg>
		<constructor-arg name="age" value="${Person.age}"></constructor-arg>
		<constructor-arg name="address" ref="addr"></constructor-arg>
		<constructor-arg name="langs">
		<list>
		<value>#{'${Person.langs}'.split(',')}</value>

		</list></constructor-arg>
		

		
		
	</bean>
	
	<bean name="addr" class="com.project.SpringCoreAndContext.beans.Address">
	
	<!--<constructor-arg name="addrId" value="1"></constructor-arg>
	<constructor-arg name="city" value="Hyderabad"></constructor-arg>
	<constructor-arg name="state" value="Telangana"></constructor-arg>-->
	
	
	<constructor-arg name="addrId" value="${Address.addrId}"></constructor-arg>
	<constructor-arg name="city" value="${Address.city}"></constructor-arg>
	<constructor-arg name="state" value="${Address.state}"></constructor-arg>
	</bean>

	<!-- bean definitions here -->

</beans>