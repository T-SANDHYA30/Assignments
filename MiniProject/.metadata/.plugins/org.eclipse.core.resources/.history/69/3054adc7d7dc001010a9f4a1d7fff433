
package com.servlet;

import java.io.IOException;
import java.util.List;

import com.dao.QuizDAO;
import com.model.Question;
import com.model.Quiz;
import com.model.User;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/user/attemptQuiz")
public class AttemptQuizServlet extends HttpServlet {
    private final QuizDAO quizDAO = new QuizDAO();

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession();
        User user = (User) session.getAttribute("user");
        if (user == null) {
            response.sendRedirect(request.getContextPath() + "/user/login");
            return;
        }

        // Parse quizId safely
        String quizIdParam = request.getParameter("quizId");
        if (quizIdParam == null) {
            request.setAttribute("error", "Quiz not specified.");
            request.getRequestDispatcher("/user/error.jsp").forward(request, response);
            return;
        }

        int quizId;
        try {
            quizId = Integer.parseInt(quizIdParam);
        } catch (NumberFormatException e) {
            request.setAttribute("error", "Invalid quiz id.");
            request.getRequestDispatcher("/user/error.jsp").forward(request, response);
            return;
        }

        // Load quiz and questions
        Quiz quiz = quizDAO.getQuizById(quizId);
        if (quiz == null) {
            request.setAttribute("error", "Quiz not found.");
            request.getRequestDispatcher("/user/error.jsp").forward(request, response);
            return;
        }

        List<Question> questions = quizDAO.getQuizQuestions(quizId);

        // Guard against null/empty list
        if (questions == null || questions.isEmpty()) {
            quiz.setQuestions(questions); // keep consistent even if empty
            session.setAttribute("currentQuiz", quiz);
            session.setAttribute("currentQuestionIndex", 0);

            request.setAttribute("quiz", quiz);
            request.setAttribute("totalQuestions", 0);
            request.setAttribute("error", "This quiz currently has no questions.");
            request.getRequestDispatcher("/user/attemptQuiz.jsp").forward(request, response);
            return;
        }

        // Normal flow when we have at least one question
        quiz.setQuestions(questions);
        session.setAttribute("currentQuiz", quiz);
        session.setAttribute("currentQuestionIndex", 0);

        request.setAttribute("quiz", quiz);
        request.setAttribute("question", questions.get(0)); // safe now
        request.setAttribute("questionNumber", 1);
        request.setAttribute("totalQuestions", questions.size());

        request.getRequestDispatcher("/user/attemptQuiz.jsp").forward(request, response);
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession();
        User user = (User) session.getAttribute("user");
        if (user == null) {
            response.sendRedirect(request.getContextPath() + "/user/login");
            return;
        }

        Quiz quiz = (Quiz) session.getAttribute("currentQuiz");
        if (quiz == null) {
            // Session lost or direct POST without GET initialization
            request.setAttribute("error", "No active quiz session. Please start the quiz again.");
            request.getRequestDispatcher("/user/error.jsp").forward(request, response);
            return;
        }

        List<Question> questions = quiz.getQuestions();
        if (questions == null || questions.isEmpty()) {
            request.setAttribute("quiz", quiz);
            request.setAttribute("totalQuestions", 0);
            request.setAttribute("error", "This quiz currently has no questions.");
            request.getRequestDispatcher("/user/attemptQuiz.jsp").forward(request, response);
            return;
        }

        Object indexObj = session.getAttribute("currentQuestionIndex");
        int currentIndex = (indexObj instanceof Integer) ? (Integer) indexObj : 0;

        // Clamp index to bounds
        if (currentIndex < 0) currentIndex = 0;
        if (currentIndex >= questions.size()) currentIndex = questions.size() - 1;

        // Store user's answer safely
        Question currentQ = questions.get(currentIndex);
        String answerKey = "answer_" + currentQ.getQuestionId();

        String selectedOption = request.getParameter("selectedOption");
        if (selectedOption != null && !selectedOption.isEmpty()) {
            try {
                session.setAttribute(answerKey, Integer.parseInt(selectedOption));
            } catch (NumberFormatException ignored) {
                // Ignore invalid option; optionally set an error attribute if desired
            }
        }

        String action = request.getParameter("action");

        if ("next".equals(action)) {
            if (currentIndex < questions.size() - 1) {
                currentIndex++;
            }
            session.setAttribute("currentQuestionIndex", currentIndex);

        } else if ("previous".equals(action)) {
            if (currentIndex > 0) {
                currentIndex--;
            }
            session.setAttribute("currentQuestionIndex", currentIndex);

        } else if ("submit".equals(action)) {
            response.sendRedirect(request.getContextPath() + "/user/submitQuiz");
            return;

        } else {
            // Unknown action: keep current index
            session.setAttribute("currentQuestionIndex", currentIndex);
        }

        Question currentQuestion = questions.get(currentIndex);
        Integer savedAnswer = (Integer) session.getAttribute("answer_" + currentQuestion.getQuestionId());

        request.setAttribute("quiz", quiz);
        request.setAttribute("question", currentQuestion);
        request.setAttribute("questionNumber", currentIndex + 1);
        request.setAttribute("totalQuestions", questions.size());
        request.setAttribute("savedAnswer", savedAnswer);

        request.getRequestDispatcher("/user/attemptQuiz.jsp").forward(request, response);
    }
}
