
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="com.model.Admin" %>
<%
    Admin admin = (Admin) session.getAttribute("admin");
    if (admin == null) {
        response.sendRedirect(request.getContextPath() + "/admin/login");
        return;
    }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Dashboard - Quiz App</title>
    <style>
        /* Reset */
        * {
            margin: 0; padding: 0; box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: #f4f6f9;
            color: #2c3e50;
            min-height: 100vh;
        }
        .layout {
            display: flex;
            min-height: 100vh;
        }
        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #2c3e50;
            color: #fff;
            padding: 24px 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .logo {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 36px;
            text-align: center;
            color: #ecf0f1;
        }
        .menu-item {
            padding: 14px 18px;
            margin-bottom: 12px;
            border-radius: 8px;
            text-decoration: none;
            color: #ecf0f1;
            font-weight: 500;
            display: block;
            transition: background 0.3s ease;
        }
        .menu-item:hover {
            background: #34495e;
        }
        .menu-item.active {
            background: #1abc9c;
            color: #fff;
        }
        .logout-btn {
            padding: 14px 18px;
            border-radius: 8px;
            text-decoration: none;
            color: #fff;
            font-weight: 600;
            text-align: center;
            background: #e74c3c;
            transition: background 0.3s ease;
            margin-top: auto;
        }
        .logout-btn:hover {
            background: #c0392b;
        }
        /* Main Content */
        .main-content {
            flex: 1;
            padding: 40px 50px;
            background: #ffffff;
            box-shadow: inset 0 0 20px #f0f0f0;
            overflow-y: auto;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 36px;
        }
        h1 {
            font-size: 32px;
            font-weight: 700;
            color: #2c3e50;
        }
        .welcome {
            font-size: 18px;
            color: #7f8c8d;
            font-weight: 500;
        }
        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
            margin-bottom: 40px;
        }
        .stat-card {
            background: #f9fafb;
            padding: 28px 32px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        }
        .stat-card h3 {
            font-size: 14px;
            color: #7f8c8d;
            margin-bottom: 14px;
            letter-spacing: 1px;
        }
        .stat-card .number {
            font-size: 40px;
            font-weight: 700;
            color: #1abc9c;
        }
        /* Table Container */
        .table-container {
            background: #ffffff;
            padding: 32px 36px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .table-header h2 {
            font-weight: 700;
            color: #2c3e50;
        }
        p {
            color: #7f8c8d;
            font-size: 15px;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div>
                <div class="logo">🎯 QUIZ APP</div>
                ${pageContext.request.contextPath}/admin/dashboard📊 Dashboard</a>
                ${pageContext.request.contextPath}/admin/quizManager📝 Quiz Manager</a>
                ${pageContext.request.contextPath}/admin/questionList❓ Question Manager</a>
                ${pageContext.request.contextPath}/admin/addQuestion➕ Add New Question</a>
                ${pageContext.request.contextPath}/admin/createQuiz🆕 Create Quiz</a>
            </div>
            ${pageContext.request.contextPath}/user/home.jspLogout</a>
        </aside>
        <main class="main-content">
            <div class="header">
                <h1>Dashboard</h1>
                <div class="welcome">Welcome, <%= admin.getFullName() != null ? admin.getFullName() : admin.getUsername() %>!</div>
            </div>
            
            <section class="stats-grid">
                <div class="stat-card">
                    <h3>TOTAL QUIZ</h3>
                    <div class="number"><%= request.getAttribute("totalQuiz") != null ? request.getAttribute("totalQuiz") : "0" %></div>
                </div>
                <div class="stat-card">
                    <h3>TOTAL QUESTIONS</h3>
                    <div class="number"><%= request.getAttribute("totalQuestions") != null ? request.getAttribute("totalQuestions") : "0" %></div>
                </div>
                <div class="stat-card">
                    <h3>TOTAL USERS</h3>
                    <div class="number"><%= request.getAttribute("totalUsers") != null ? request.getAttribute("totalUsers") : "0" %></div>
                </div>
            </section>
            
            <section class="table-container">
                <div class="table-header">
                    <h2>Tables</h2>
                </div>
                <p>DataTables Example</p>
                <p style="margin-top: 20px; color: #7f8c8d;">
                    Navigate to Quiz Manager or Question Manager to view detailed tables.
                </p>
            </section>
               </main>
    </div>
</body>
