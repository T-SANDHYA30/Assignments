
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Online Quiz Portal</title>
    <style>
        /* Reset and base styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f8f9fa, #e3f2fd);
            color: #212121;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar */
        .navbar {
            background: #673ab7;
            padding: 18px 60px;
                       color: #fff;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .nav-links a {
            color: #fff;
            text-decoration: none;
            margin-left: 30px;
            font-size: 16px;
            font-weight: 500;
            transition: color 0.3s ease;
        }
        .nav-links a:hover {
            color: #ffeb3b;
        }

        /* Hero Section */
        .hero {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 60px 20px;
        }
        .hero h1 {
            font-size: 50px;
            font-weight: 800;
            margin-bottom: 20px;
            color: #4a148c;
        }
        .hero p {
            font-size: 20px;
            margin-bottom: 40px;
            color: #555;
            max-width: 600px;
        }
        .btn-login-hero {
            background: #ff5722;
            color: white;
            padding: 14px 36px;
            border-radius: 50px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(255, 87, 34, 0.4);
            transition: background-color 0.3s ease, transform 0.3s ease;
        }
        .btn-login-hero:hover {
            background: #e64a19;
            transform: scale(1.05);
        }

        /* Responsive */
        @media (max-width: 700px) {
            .navbar {
                flex-direction: column;
                padding: 15px 25px;
            }
            .nav-links {
                margin-top: 10px;
            }
            .nav-links a {
                margin-left: 0;
                margin-right: 20px;
                font-size: 15px;
            }
            .hero h1 {
                font-size: 36px;
            }
            .hero p {
                font-size: 16px;
                max-width: 90%;
            }
            .btn-login-hero {
                padding: 12px 28px;
                font-size: 16px;
            }
        }
    </style>
</head>
